# Modèle des variables d'environnement.
# Copier ce fichier en « .env » pour le développement local et remplir les valeurs.
# Ne JAMAIS committer le fichier .env : il contient des secrets.
# En recette et en production, ces variables sont saisies dans la console de l'hébergeur.

# --- Général ---
NODE_ENV=development
# Fuseau de référence de l'hôtel (dates de séjour, heures limites)
TZ=Europe/Paris

# --- API ---
API_PORT=3000
# Adresses autorisées à appeler l'API (CORS), séparées par des virgules, sans chemin ni « * ».
# Obligatoire en production : uniquement le site public et l'outil de gestion.
API_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
# Nombre de serveurs intermédiaires (proxy) devant l'API : 0 en local.
# À régler selon l'hébergeur ; une valeur fausse permet de contourner la limitation des requêtes.
# Le serveur du site public appelle l'API pour la réservation et transmet l'adresse du visiteur :
# en production, le compter (au moins 1), sinon tous les visiteurs partagent une même limite.
TRUST_PROXY=0
# Niveau de détail du journal : fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info

# --- Site public (serveur de rendu) ---
# Noms de domaine servis, séparés par des virgules (sans http://). Obligatoire en production ;
# vide en local : tous les noms sont acceptés.
ALLOWED_HOSTS=
# Adresse de l'API lue par le serveur du site (catalogue, réservation). Vide en local :
# http://localhost:3000/api/v1. Le navigateur des visiteurs n'appelle jamais l'API : elle peut
# rester sur un réseau interne (le site relaie les photos et la réservation).
API_INTERNAL_URL=
# Nombre de serveurs intermédiaires (proxy) devant le serveur du site : 0 en local.
SITE_TRUST_PROXY=0

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://riad:changeme@localhost:5432/riad_dev
# Base DÉDIÉE aux tests automatisés (son nom doit contenir « test ») ; jamais la base ci-dessus.
# Vide : les tests qui ont besoin de PostgreSQL sont affichés comme ignorés.
TEST_DATABASE_URL=postgres://riad:changeme@localhost:5432/riad_test

# --- Données de démonstration (portfolio uniquement, jamais pour un hôtel réel) ---
# true pour autoriser « npm run db:seed:demo »
DEMO_MODE=false
# Mot de passe des 4 comptes de démonstration (12 caractères minimum, aucun par défaut)
DEMO_USER_PASSWORD=

# --- Sessions du personnel ---
# Chaîne aléatoire d'au moins 32 caractères, différente par environnement. Obligatoire pour
# démarrer l'API. Pour en générer une :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Adresse de l'outil de gestion, pour les liens envoyés par e-mail (mot de passe).
# Vide en local : http://localhost:4300. Obligatoire en production (https).
ADMIN_APP_URL=
# Dossier des photos envoyées par le personnel. Vide en local : dossier « storage » à la racine
# (ignoré par Git). Obligatoire en production (disque persistant).
STORAGE_DIR=

# --- Paiement en ligne Stripe (mode test uniquement pour le portfolio) ---
# Clé secrète « sk_test_… » (tableau de bord Stripe → Développeurs → Clés API), propre à ce
# projet. Vide en local : la réservation en ligne répond « paiement non configuré ». Une clé
# « sk_live_ » est refusée hors production. Obligatoire en production.
STRIPE_SECRET_KEY=
# Secret des notifications Stripe (« whsec_… ») : affiché par « stripe listen » en local, donné
# par le tableau de bord Stripe (Développeurs → Webhooks) en production. Vide en local : les
# réservations payées restent « en attente ». Obligatoire en production. Jamais dans le chat.
STRIPE_WEBHOOK_SECRET=
# Adresse du site public : la page de paiement n'y renvoie que là. Vide en local :
# http://localhost:4200. Obligatoire en production (https).
PUBLIC_SITE_URL=

# --- Brevo (e-mails) — étape R-6 ---
# Clé d'API Brevo (« xkeysib-… ») : Brevo → SMTP et API → Clés API. Jamais dans Git ni dans le
# chat. Vide en local : les e-mails sont écrits dans le dossier outbox. Obligatoire en production.
BREVO_API_KEY=
# Expéditeur vérifié dans Brevo (adresse seule, ou domaine authentifié pour le vrai hôtel).
MAIL_FROM_ADDRESS=
# Nom affiché avec l'expéditeur (par défaut : Hôtel Riad Vieux-Port).
MAIL_FROM_NAME=
# DÉVELOPPEMENT SEULEMENT : tous les e-mails envoyés par Brevo partent à cette adresse (la
# vôtre), l'adresse réelle étant écrite dans l'objet. Obligatoire avec BREVO_API_KEY hors
# production, interdite en production.
MAIL_REDIRECT_TO=

# --- Stockage de fichiers S3 (photos, factures) — phase 4 ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Suivi des erreurs — phase 1.2 ---
SENTRY_DSN=
