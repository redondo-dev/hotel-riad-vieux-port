{
  "name": "@riad/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST et tâches de fond de l'Hôtel Riad Vieux-Port",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=../../.env db/migrate.ts down",
    "db:status": "node --env-file-if-exists=../../.env db/migrate.ts status",
    "db:seed:demo": "node --env-file-if-exists=../../.env db/seed-demo.ts",
    "db:test:sql": "bash db/tests/run-sql-tests.sh"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.0",
    "sharp": "^0.34.3",
    "stripe": "^23.1.0",
    "umzug": "^3.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.13",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0"
  }
}
