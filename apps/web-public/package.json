{
  "name": "@riad/web-public",
  "version": "0.1.0",
  "private": true,
  "description": "Site public et réservation en ligne de l'Hôtel Riad Vieux-Port",
  "scripts": {
    "start": "ng serve",
    "start:en": "ng serve --configuration=development-en",
    "build": "ng build",
    "serve:ssr": "node dist/web-public/server/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "i18n:extract": "ng extract-i18n --format=json --output-path=src/locale"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/localize": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-angular": ">=0.468.0 <1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/express": "^5.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0"
  }
}
