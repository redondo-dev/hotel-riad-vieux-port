import { mkdir, readdir, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';

/**
 * Makes the fixed photos of the public site (P-4): « npm run images:site -- <folder> ».
 * Run by Node directly (TypeScript without types checking, « .mts »: always a module).
 *
 * Reads hero.jpg, hotel.jpg and quartier.jpg (or .jpeg, .png, .webp) in <folder>, which stays
 * OUTSIDE the project (the originals are not saved in git), and writes for each one three WebP
 * versions in apps/web-public/public/images/site: turned the way the camera says, without any
 * metadata (GPS position, camera, date), never enlarged. Then rewrites site-photos.generated.ts
 * from the files present, so that the pages know which photos exist and their size.
 * A missing photo is only reported: its page keeps the « Photo à venir » placeholder.
 */

interface Target {
  name: string;
  /** Widths made, in pixels; a width larger than the original is not made. */
  widths: number[];
}

const TARGETS: Target[] = [
  // Full width of the screen, under the title of the home page.
  { name: 'hero', widths: [800, 1280, 1920] },
  { name: 'hotel', widths: [400, 800, 1200] },
  { name: 'quartier', widths: [400, 800, 1200] },
];

const EXTENSIONS = ['.jpg', '.jpeg', '.png', '.webp'];
const ACCEPTED_FORMATS = ['jpeg', 'png', 'webp'];
const WEBP_QUALITY = 80;

const OUTPUT = fileURLToPath(new URL('../public/images/site/', import.meta.url));
const GENERATED = fileURLToPath(
  new URL('../src/app/core/data/site-photos.generated.ts', import.meta.url),
);

function sourceOf(folderFiles: string[], name: string): string | undefined {
  return folderFiles.find((file) =>
    EXTENSIONS.some((extension) => file.toLowerCase() === `${name}${extension}`),
  );
}

/** Makes the versions of one photo; returns false when the file cannot be used. */
async function makeVersions(target: Target, input: string): Promise<boolean> {
  const metadata = await sharp(input, { failOn: 'error' }).metadata();
  const format = metadata.format ?? 'inconnu';
  if (!ACCEPTED_FORMATS.includes(format)) {
    console.error(`✗ ${target.name} : format ${format} refusé (JPEG attendu).`);
    return false;
  }
  // The width once turned the way the camera says (EXIF orientation 5 to 8: a quarter turn).
  const turned = (metadata.orientation ?? 1) >= 5;
  const sourceWidth = (turned ? metadata.height : metadata.width) ?? 0;
  const widths = target.widths.filter((width) => width <= sourceWidth);
  if (widths.length === 0) {
    console.error(`✗ ${target.name} : ${sourceWidth} px de large, trop petite.`);
    return false;
  }
  for (const width of widths) {
    await sharp(input, { failOn: 'error' })
      .rotate()
      .resize({ width })
      .webp({ quality: WEBP_QUALITY })
      .toFile(join(OUTPUT, `${target.name}-${width}.webp`));
  }
  const largest = target.widths.at(-1) ?? 0;
  const note = sourceWidth < largest ? ` (original de ${sourceWidth} px, moins de ${largest})` : '';
  console.log(`✓ ${target.name} : ${widths.join(', ')} px${note}`);
  return true;
}

/** What is in the output folder, read back from the files themselves. */
async function presentPhotos(): Promise<string[]> {
  const files = await readdir(OUTPUT);
  const lines: string[] = [];
  for (const target of TARGETS) {
    const widths = target.widths.filter((width) => files.includes(`${target.name}-${width}.webp`));
    const largest = widths.at(-1);
    if (largest === undefined) {
      continue;
    }
    const size = await sharp(join(OUTPUT, `${target.name}-${largest}.webp`)).metadata();
    lines.push(
      `  ${target.name}: { widths: [${widths.join(', ')}], width: ${size.width}, height: ${size.height} },`,
    );
  }
  return lines;
}

async function writeGenerated(lines: string[]): Promise<void> {
  const files = lines.length === 0 ? '{}' : `{\n${lines.join('\n')}\n}`;
  const content = `// Generated by « npm run images:site »: do not edit by hand.
// The fixed photos of the site, in apps/web-public/public/images/site (WebP, no metadata).

export interface SitePhotoFiles {
  /** Widths of the stored versions, smallest first. */
  widths: number[];
  /** Size of the largest version. */
  width: number;
  height: number;
}

export const SITE_PHOTO_FILES: Partial<Record<string, SitePhotoFiles>> = ${files};
`;
  await writeFile(GENERATED, content);
}

async function main(): Promise<void> {
  const folder = process.argv[2];
  if (folder === undefined || folder.trim() === '') {
    console.error('Usage : npm run images:site -- "C:\\chemin\\vers\\photos-unsplash\\site"');
    process.exitCode = 1;
    return;
  }
  const folderFiles = await readdir(folder);
  await mkdir(OUTPUT, { recursive: true });
  let failed = false;
  for (const target of TARGETS) {
    const source = sourceOf(folderFiles, target.name);
    if (source === undefined) {
      console.warn(`– ${target.name} : aucun fichier ${target.name}.jpg, photo inchangée.`);
      continue;
    }
    failed = !(await makeVersions(target, join(folder, source))) || failed;
  }
  await writeGenerated(await presentPhotos());
  console.log('Liste des photos du site mise à jour (site-photos.generated.ts).');
  if (failed) {
    process.exitCode = 1;
  }
}

await main();
