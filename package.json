{
  "name": "hotel-riad-vieux-port",
  "version": "0.1.0",
  "private": true,
  "description": "Site de réservation et outil de gestion de l'Hôtel Riad Vieux-Port (Marseille)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "start:public": "npm run start --workspace=@riad/web-public",
    "start:public:en": "npm run start:en --workspace=@riad/web-public",
    "start:api": "npm run start --workspace=@riad/api",
    "dev:api": "npm run dev --workspace=@riad/api",
    "start:admin": "npm run start --workspace=@riad/web-admin",
    "db:migrate": "npm run db:migrate --workspace=@riad/api",
    "db:rollback": "npm run db:rollback --workspace=@riad/api",
    "db:status": "npm run db:status --workspace=@riad/api",
    "db:seed:demo": "npm run db:seed:demo --workspace=@riad/api",
    "db:test:sql": "npm run db:test:sql --workspace=@riad/api",
    "images:site": "node apps/web-public/scripts/images-site.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.1.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,scss,css}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
